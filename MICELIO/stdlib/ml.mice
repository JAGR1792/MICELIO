# ===================================================================
# ml.mice – Módulo de algoritmos de aprendizaje automático
# Implementación de modelos simples desde cero
# ===================================================================

importar "math.mice" como math

# Divide datos en entrenamiento y prueba
funcion dividir_datos(X, Y, proporcion_train) {
    var n = X.longitud()
    var indice_split = n * proporcion_train
    var X_train = []
    var X_test = []
    var Y_train = []
    var Y_test = []
    var i = 0
    mientras (i < n) {
        si (i < indice_split) {
            X_train.agregar(X[i])
            Y_train.agregar(Y[i])
        } sino {
            X_test.agregar(X[i])
            Y_test.agregar(Y[i])
        }
        i = i + 1
    }
    regresa {"X_train": X_train, "X_test": X_test, "Y_train": Y_train, "Y_test": Y_test}
}

# Calcula media
funcion media(valores) {
    regresa suma(valores) / valores.longitud()
}

# Calcula varianza
funcion varianza(valores) {
    var m = media(valores)
    var suma_desv = 0
    para v en valores {
        suma_desv = suma_desv + ((v - m) * (v - m))
    }
    regresa suma_desv / valores.longitud()
}

# Calcula desviación estándar
funcion desviacion_estandar(valores) {
    regresa math.raiz(varianza(valores))
}

# Normaliza valores (z-score)
funcion normalizar(valores) {
    var m = media(valores)
    var de = desviacion_estandar(valores)
    var result = []
    para v en valores {
        si (de == 0) {
            result.agregar(0)
        } sino {
            result.agregar((v - m) / de)
        }
    }
    regresa result
}

# Regresión lineal: calcula pendiente e intercepción
funcion regresion_lineal(X, Y) {
    var n = X.longitud()
    var suma_xy = 0
    var suma_x2 = 0
    var suma_x = 0
    var suma_y = 0
    var i = 0
    mientras (i < n) {
        suma_xy = suma_xy + (X[i] * Y[i])
        suma_x2 = suma_x2 + (X[i] * X[i])
        suma_x = suma_x + X[i]
        suma_y = suma_y + Y[i]
        i = i + 1
    }
    var m = (n * suma_xy - suma_x * suma_y) / (n * suma_x2 - suma_x * suma_x)
    var b = (suma_y - m * suma_x) / n
    regresa {"pendiente": m, "intercepcion": b}
}

# Predice valores con regresión lineal
funcion predecir_lineal(x, modelo) {
    regresa modelo["pendiente"] * x + modelo["intercepcion"]
}

# K-Means: agrupa datos en k clusters
funcion k_means(X, k, iteraciones) {
    var n = X.longitud()
    var dim = 2
    si (n > 0 y tipo(X[0]) == "lista") {
        dim = X[0].longitud()
    }
    # Inicialización: elegir k indices aleatorios distintos (Fisher-Yates parcial)
    var indices = []
    var i = 0
    mientras (i < n) {
        indices.agregar(i)
        i = i + 1
    }
    i = 0
    mientras (i < k y i < n) {
        var r = i + aEntero(aleatorio() * (n - i))
        var tmp = indices[i]
        indices[i] = indices[r]
        indices[r] = tmp
        i = i + 1
    }
    var centroides = []
    i = 0
    mientras (i < k) {
        centroides.agregar(X[indices[i]])
        i = i + 1
    }
    var asignaciones = []
    var iter = 0
    mientras (iter < iteraciones) {
        asignaciones = []
        para punto en X {
            var dist_min = 999999
            var indice_cercano = 0
            var j = 0
            mientras (j < k) {
                var dist = distancia_euclidiana(punto, centroides[j])
                si (dist < dist_min) {
                    dist_min = dist
                    indice_cercano = j
                }
                j = j + 1
            }
            asignaciones.agregar(indice_cercano)
        }
        var nuevos = []
        var conteos = []
        i = 0
        mientras (i < k) {
            var suma = []
            var d = 0
            mientras (d < dim) {
                suma.agregar(0)
                d = d + 1
            }
            nuevos.agregar(suma)
            conteos.agregar(0)
            i = i + 1
        }
        i = 0
        mientras (i < n) {
            var cid = asignaciones[i]
            var d = 0
            mientras (d < dim) {
                nuevos[cid][d] = nuevos[cid][d] + X[i][d]
                d = d + 1
            }
            conteos[cid] = conteos[cid] + 1
            i = i + 1
        }
        i = 0
        mientras (i < k) {
            si (conteos[i] > 0) {
                var d = 0
                mientras (d < dim) {
                    centroides[i][d] = nuevos[i][d] / conteos[i]
                    d = d + 1
                }
            }
            i = i + 1
        }
        iter = iter + 1
    }
    regresa {"centroides": centroides, "asignaciones": asignaciones}
}

# Calcula distancia euclidiana
funcion distancia_euclidiana(p1, p2) {
    si (tipo(p1) == "numero" y tipo(p2) == "numero") {
        var d = p1 - p2
        regresa math.raiz(d * d)
    }
    var suma = 0
    var i = 0
    mientras (i < p1.longitud()) {
        var diff = p1[i] - p2[i]
        suma = suma + (diff * diff)
        i = i + 1
    }
    regresa math.raiz(suma)
}

# Calcula matriz de confusión
funcion matriz_confusion(predichos, reales) {
    var tp = 0
    var tn = 0
    var fp = 0
    var fn = 0
    var i = 0
    mientras (i < predichos.longitud()) {
        si (predichos[i] == 1 y reales[i] == 1) {
            tp = tp + 1
        } sino_si (predichos[i] == 0 y reales[i] == 0) {
            tn = tn + 1
        } sino_si (predichos[i] == 1 y reales[i] == 0) {
            fp = fp + 1
        } sino {
            fn = fn + 1
        }
        i = i + 1
    }
    regresa {"tp": tp, "tn": tn, "fp": fp, "fn": fn}
}

# Calcula exactitud
funcion exactitud(predichos, reales) {
    var correctos = 0
    var i = 0
    mientras (i < predichos.longitud()) {
        si (predichos[i] == reales[i]) {
            correctos = correctos + 1
        }
        i = i + 1
    }
    regresa correctos / predichos.longitud()
}

# Calcula precisión
funcion precision(predichos, reales) {
    var conf = matriz_confusion(predichos, reales)
    si (conf["tp"] + conf["fp"] == 0) {
        regresa 0
    }
    regresa conf["tp"] / (conf["tp"] + conf["fp"])
}

# Calcula recall
funcion recall(predichos, reales) {
    var conf = matriz_confusion(predichos, reales)
    si (conf["tp"] + conf["fn"] == 0) {
        regresa 0
    }
    regresa conf["tp"] / (conf["tp"] + conf["fn"])
}

# Calcula F1-score
funcion f1_score(predichos, reales) {
    var p = precision(predichos, reales)
    var r = recall(predichos, reales)
    si (p + r == 0) {
        regresa 0
    }
    regresa 2 * (p * r) / (p + r)
}


# ===================================================================
# ACTIVACIONES Y PÉRDIDAS
# ===================================================================

# Función Sigmoide
funcion sigmoid(z) {
    regresa 1.0 / (1.0 + exp(-z))
}

# Derivada de Sigmoide
funcion sigmoid_derivada(z) {
    var s = sigmoid(z)
    regresa s * (1.0 - s)
}

# Error Matemático Básico para no depender de math.mice
funcion __log_basico(x) {
    # Aproximación o uso asumiendo logarítmo nativo si existe, 
    # pero como necesitamos Log Loss, dependemos de math.mice (log)
    regresa 0
}

# Error Cuadrático Medio (MSE)
funcion mse(y_real, y_pred) {
    var n = y_real.longitud()
    var suma_error = 0
    var i = 0
    mientras (i < n) {
        var diff = y_real[i] - y_pred[i]
        suma_error = suma_error + (diff * diff)
        i = i + 1
    }
    si (n == 0) { regresa 0 }
    regresa suma_error / n
}

# ===================================================================
# MODELOS AVANZADOS
# ===================================================================

# Regresión Logística (Descenso de Gradiente 1D)
funcion regresion_logistica(X, Y, learning_rate, iteraciones) {
    var n = X.longitud()
    var m = 0.0 # pendiente
    var b = 0.0 # intercepción
    
    var i = 0
    mientras (i < iteraciones) {
        var sum_m = 0.0
        var sum_b = 0.0
        
        var j = 0
        mientras (j < n) {
            var z = m * X[j] + b
            var p = sigmoid(z)
            var err = p - Y[j]
            
            sum_m = sum_m + (err * X[j])
            sum_b = sum_b + err
            j = j + 1
        }
        
        m = m - (learning_rate * sum_m / n)
        b = b - (learning_rate * sum_b / n)
        i = i + 1
    }
    
    regresa {"pendiente": m, "intercepcion": b}
}

# Predicción Regresión Logística
funcion predecir_logistica(x, modelo) {
    var z = modelo["pendiente"] * x + modelo["intercepcion"]
    si (sigmoid(z) >= 0.5) {
        regresa 1
    }
    regresa 0
}


# R-cuadrado (Coeficiente de determinación)
funcion r_cuadrado(y_real, y_pred) {
    var n = y_real.longitud()
    var media_y = media(y_real)
    
    var ss_tot = 0
    var ss_res = 0
    var i = 0
    mientras (i < n) {
        var diff_tot = y_real[i] - media_y
        ss_tot = ss_tot + (diff_tot * diff_tot)
        
        var diff_res = y_real[i] - y_pred[i]
        ss_res = ss_res + (diff_res * diff_res)
        
        i = i + 1
    }
    
    si (ss_tot == 0) { regresa 1 }
    regresa 1 - (ss_res / ss_tot)
}

# Regresión Lineal (Descenso de Gradiente 1D)
funcion regresion_lineal_descenso(X, Y, learning_rate, iteraciones) {
    var n = X.longitud()
    var m = 0.0
    var b = 0.0
    
    var i = 0
    mientras (i < iteraciones) {
        var sum_m = 0.0
        var sum_b = 0.0
        
        var j = 0
        mientras (j < n) {
            var pred = m * X[j] + b
            var err = pred - Y[j]
            
            sum_m = sum_m + (err * X[j])
            sum_b = sum_b + err
            j = j + 1
        }
        
        m = m - (learning_rate * 2 * sum_m / n)
        b = b - (learning_rate * 2 * sum_b / n)
        i = i + 1
    }
    
    regresa {"pendiente": m, "intercepcion": b}
}


# Regresión Lineal Matricial (Mínimos Cuadrados)
# Requiere importar matriz.mice en tu programa principal
# Ecuación: beta = (X^T * X)^-1 * X^T * Y
funcion regresion_lineal_matricial(X, Y) {
    var X_T = transpuesta(X)
    var X_T_X = multiplicar(X_T, X)
    var inv_X_T_X = inversa(X_T_X)
    var X_T_Y = multiplicar(X_T, Y)
    var beta = multiplicar(inv_X_T_X, X_T_Y)
    regresa beta
}

