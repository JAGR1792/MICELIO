importar "../stdlib/math.mice" como math

const _ANCHO = 800
const _ALTO = 500
const _MARGEN = 48

var _titulo = "Grafico Micelio"
var _xlabel = "x"
var _ylabel = "y"

var _line_r = 36
var _line_g = 88
var _line_b = 216

var _point_r = 220
var _point_g = 40
var _point_b = 40

var _bar_r = 58
var _bar_g = 145
var _bar_b = 81

var _grid_r = 230
var _grid_g = 230
var _grid_b = 230

var _axis_r = 80
var _axis_g = 80
var _axis_b = 80

var _text_r = 50
var _text_g = 50
var _text_b = 50

var _usar_marcadores = verdadero
var _tam_marcador = 3
var _last_xmin = 0
var _last_xmax = 1
var _last_ymin = 0
var _last_ymax = 1

funcion _min_lista(xs) {
    var m = xs[0]
    var i = 1
    mientras (i < longitud(xs)) {
        si (xs[i] < m) { m = xs[i] }
        i = i + 1
    }
    regresa m
}

funcion _max_lista(xs) {
    var m = xs[0]
    var i = 1
    mientras (i < longitud(xs)) {
        si (xs[i] > m) { m = xs[i] }
        i = i + 1
    }
    regresa m
}

funcion _dibujar_rejilla() {
    var left = _MARGEN
    var right = _ANCHO - _MARGEN
    var top = _MARGEN
    var bottom = _ALTO - _MARGEN
    var pasos = 8
    var i = 1
    mientras (i < pasos) {
        var xv = left + aEntero((i * (right - left)) / pasos)
        var yv = top + aEntero((i * (bottom - top)) / pasos)
        __grafico_linea(xv, top, xv, bottom, _grid_r, _grid_g, _grid_b, 1)
        __grafico_linea(left, yv, right, yv, _grid_r, _grid_g, _grid_b, 1)
        i = i + 1
    }
}

funcion _dibujar_ejes() {
    var left = _MARGEN
    var right = _ANCHO - _MARGEN
    var top = _MARGEN
    var bottom = _ALTO - _MARGEN
    __grafico_linea(left, bottom, right, bottom, _axis_r, _axis_g, _axis_b, 2)
    __grafico_linea(left, top, left, bottom, _axis_r, _axis_g, _axis_b, 2)
}

funcion _formatear_numero(n) {
    var s = ""
    var v = n
    si (v < 0) {
        s = "-"
        v = -v
    }
    var entero = aEntero(v)
    si (v == entero) {
        regresa s + aTexto(entero)
    }
    var dec = aEntero((v - entero) * 10 + 0.5)
    si (dec > 9) {
        entero = entero + 1
        dec = 0
    }
    regresa s + aTexto(entero) + "." + aTexto(dec)
}

funcion _dibujar_ticks(xmin, xmax, ymin, ymax) {
    var left = _MARGEN
    var right = _ANCHO - _MARGEN
    var top = _MARGEN
    var bottom = _ALTO - _MARGEN
    var pasos = 8
    var i = 0
    mientras (i <= pasos) {
        var tx = left + aEntero((i * (right - left)) / pasos)
        var ty = bottom
        __grafico_linea(tx, ty, tx, ty + 5, _axis_r, _axis_g, _axis_b, 2)

        var vx = xmin + ((i * (xmax - xmin)) / pasos)
        __grafico_texto(tx - 10, ty + 6, _formatear_numero(vx), _text_r, _text_g, _text_b, 10)

        var ly = bottom - aEntero((i * (bottom - top)) / pasos)
        __grafico_linea(left - 5, ly, left, ly, _axis_r, _axis_g, _axis_b, 2)

        var vy = ymin + ((i * (ymax - ymin)) / pasos)
        __grafico_texto(4, ly - 6, _formatear_numero(vy), _text_r, _text_g, _text_b, 10)
        i = i + 1
    }
}

funcion estilo(nombre) {
    var n = aTexto(nombre)
    si (n == "claro") {
        _line_r = 36; _line_g = 88; _line_b = 216
        _point_r = 220; _point_g = 40; _point_b = 40
        _bar_r = 58; _bar_g = 145; _bar_b = 81
        _grid_r = 230; _grid_g = 230; _grid_b = 230
        _axis_r = 80; _axis_g = 80; _axis_b = 80
        _text_r = 50; _text_g = 50; _text_b = 50
        regresa "claro"
    }
    si (n == "oscuro") {
        _line_r = 124; _line_g = 189; _line_b = 255
        _point_r = 255; _point_g = 135; _point_b = 135
        _bar_r = 102; _bar_g = 214; _bar_b = 132
        _grid_r = 120; _grid_g = 120; _grid_b = 120
        _axis_r = 200; _axis_g = 200; _axis_b = 200
        _text_r = 210; _text_g = 210; _text_b = 210
        regresa "oscuro"
    }
    si (n == "ocean") {
        _line_r = 16; _line_g = 108; _line_b = 176
        _point_r = 0; _point_g = 151; _point_b = 167
        _bar_r = 32; _bar_g = 178; _bar_b = 170
        _grid_r = 215; _grid_g = 235; _grid_b = 240
        _axis_r = 64; _axis_g = 96; _axis_b = 112
        _text_r = 32; _text_g = 64; _text_b = 80
        regresa "ocean"
    }
    si (n == "retro") {
        _line_r = 140; _line_g = 80; _line_b = 32
        _point_r = 200; _point_g = 120; _point_b = 48
        _bar_r = 130; _bar_g = 110; _bar_b = 60
        _grid_r = 235; _grid_g = 228; _grid_b = 210
        _axis_r = 100; _axis_g = 84; _axis_b = 55
        _text_r = 90; _text_g = 70; _text_b = 40
        regresa "retro"
    }
    regresa "desconocido"
}

funcion marcadores(activo, tamano) {
    _usar_marcadores = activo
    var t = aEntero(tamano)
    si (t < 1) { t = 1 }
    si (t > 8) { t = 8 }
    _tam_marcador = t
    regresa [_usar_marcadores, _tam_marcador]
}

funcion iniciar_grafico(xmin, xmax, ymin, ymax) {
    __grafico_reset(_ANCHO, _ALTO, _MARGEN)
    _dibujar_rejilla()
    _dibujar_ejes()
    _dibujar_ticks(xmin, xmax, ymin, ymax)
    _last_xmin = xmin
    _last_xmax = xmax
    _last_ymin = ymin
    _last_ymax = ymax
    regresa nulo
}

funcion pintar_puntos(xs, ys, r, g, b, tam) {
    si (longitud(xs) != longitud(ys)) {
        imp "Error: pintar_puntos requiere listas x e y del mismo tamano"
        regresa nulo
    }
    var left = _MARGEN
    var right = _ANCHO - _MARGEN
    var top = _MARGEN
    var bottom = _ALTO - _MARGEN
    var spanx = _last_xmax - _last_xmin
    var spany = _last_ymax - _last_ymin
    si (spanx == 0) { spanx = 1 }
    si (spany == 0) { spany = 1 }
    var ts = aEntero(tam)

    var i = 0
    mientras (i < longitud(xs)) {
        var px = left + aEntero(((xs[i] - _last_xmin) * (right - left)) / spanx)
        var py = bottom - aEntero(((ys[i] - _last_ymin) * (bottom - top)) / spany)
        __grafico_circulo(px, py, ts, aEntero(r), aEntero(g), aEntero(b), verdadero)
        i = i + 1
    }
    regresa longitud(xs)
}

funcion pintar_mapa(xs, ys, clases, color0, color1) {
    si (longitud(xs) != longitud(ys) o longitud(xs) != longitud(clases)) {
        imp "Error: pintar_mapa requiere listas x,y,clases del mismo tamano"
        regresa nulo
    }
    var i = 0
    mientras (i < longitud(xs)) {
        var c = color1
        si (clases[i] == 0) { c = color0 }
        __grafico_set_pixel(aEntero(xs[i]), aEntero(ys[i]), c[0], c[1], c[2])
        i = i + 1
    }
    regresa longitud(xs)
}

funcion color_linea(r, g, b) {
    _line_r = aEntero(r)
    _line_g = aEntero(g)
    _line_b = aEntero(b)
    regresa [_line_r, _line_g, _line_b]
}

funcion titulo(texto) {
    _titulo = aTexto(texto)
    regresa _titulo
}

funcion etiquetas(xtext, ytext) {
    _xlabel = aTexto(xtext)
    _ylabel = aTexto(ytext)
    regresa [_xlabel, _ylabel]
}

funcion lineas(x, ys) {
    si (longitud(x) != longitud(ys)) {
        imp "Error: lineas(x,y) requiere listas del mismo tamano"
        regresa nulo
    }
    si (longitud(x) == 0) {
        imp "Error: lineas(x,y) requiere al menos un punto"
        regresa nulo
    }

    __grafico_reset(_ANCHO, _ALTO, _MARGEN)
    _dibujar_rejilla()
    _dibujar_ejes()

    var xmin = _min_lista(x)
    var xmax = _max_lista(x)
    var ymin = _min_lista(ys)
    var ymax = _max_lista(ys)

    si (xmin == xmax) { xmin = xmin - 1; xmax = xmax + 1 }
    si (ymin == ymax) { ymin = ymin - 1; ymax = ymax + 1 }

    _dibujar_ticks(xmin, xmax, ymin, ymax)

    var left = _MARGEN
    var right = _ANCHO - _MARGEN
    var top = _MARGEN
    var bottom = _ALTO - _MARGEN
    var spanx = xmax - xmin
    var spany = ymax - ymin

    var puntos = []
    var i = 0
    mientras (i < longitud(x)) {
        var px = left + aEntero(((x[i] - xmin) * (right - left)) / spanx)
        var py = bottom - aEntero(((ys[i] - ymin) * (bottom - top)) / spany)
        puntos.agregar([px, py])
        i = i + 1
    }

    i = 0
    mientras ((i + 1) < longitud(puntos)) {
        var p0 = puntos[i]
        var p1 = puntos[i + 1]
        __grafico_linea(aEntero(p0[0]), aEntero(p0[1]), aEntero(p1[0]), aEntero(p1[1]), _line_r, _line_g, _line_b, 2)
        i = i + 1
    }

    si (_usar_marcadores) {
        i = 0
        mientras (i < longitud(puntos)) {
            var p = puntos[i]
            __grafico_circulo(aEntero(p[0]), aEntero(p[1]), _tam_marcador, _point_r, _point_g, _point_b, verdadero)
            i = i + 1
        }
    }

    regresa longitud(puntos)
}

funcion dispersion(x, ys) {
    si (longitud(x) != longitud(ys)) {
        imp "Error: dispersion(x,y) requiere listas del mismo tamano"
        regresa nulo
    }
    si (longitud(x) == 0) {
        imp "Error: dispersion(x,y) requiere al menos un punto"
        regresa nulo
    }

    __grafico_reset(_ANCHO, _ALTO, _MARGEN)
    _dibujar_rejilla()
    _dibujar_ejes()

    var xmin = _min_lista(x)
    var xmax = _max_lista(x)
    var ymin = _min_lista(ys)
    var ymax = _max_lista(ys)

    si (xmin == xmax) { xmin = xmin - 1; xmax = xmax + 1 }
    si (ymin == ymax) { ymin = ymin - 1; ymax = ymax + 1 }

    _dibujar_ticks(xmin, xmax, ymin, ymax)

    var left = _MARGEN
    var right = _ANCHO - _MARGEN
    var top = _MARGEN
    var bottom = _ALTO - _MARGEN
    var spanx = xmax - xmin
    var spany = ymax - ymin

    var i = 0
    mientras (i < longitud(x)) {
        var px = left + aEntero(((x[i] - xmin) * (right - left)) / spanx)
        var py = bottom - aEntero(((ys[i] - ymin) * (bottom - top)) / spany)
        __grafico_circulo(px, py, _tam_marcador, _point_r, _point_g, _point_b, verdadero)
        i = i + 1
    }

    regresa longitud(x)
}

funcion histograma(datos, bins) {
    si (longitud(datos) == 0) {
        imp "Error: histograma(datos,bins) requiere datos"
        regresa nulo
    }

    var b = aEntero(bins)
    si (b <= 0) {
        imp "Error: bins debe ser mayor que 0"
        regresa nulo
    }

    __grafico_reset(_ANCHO, _ALTO, _MARGEN)
    _dibujar_rejilla()
    _dibujar_ejes()

    var vmin = _min_lista(datos)
    var vmax = _max_lista(datos)
    si (vmin == vmax) { vmax = vmin + 1 }

    var left = _MARGEN
    var right = _ANCHO - _MARGEN
    var top = _MARGEN
    var bottom = _ALTO - _MARGEN
    var plot_w = right - left
    var bin_w = aEntero(plot_w / b)
    si (bin_w < 1) { bin_w = 1 }

    var ancho_bin = (vmax - vmin) / b
    var counts = []
    var max_count = 0

    var j = 0
    mientras (j < b) {
        var low = vmin + (j * ancho_bin)
        var high = low + ancho_bin
        si (j == (b - 1)) { high = vmax + 0.000001 }
        var c = 0
        var i = 0
        mientras (i < longitud(datos)) {
            var v = datos[i]
            si (v >= low y v < high) { c = c + 1 }
            i = i + 1
        }
        counts.agregar(c)
        si (c > max_count) { max_count = c }
        j = j + 1
    }

    si (max_count <= 0) { max_count = 1 }

    _dibujar_ticks(vmin, vmax, 0, max_count)

    j = 0
    mientras (j < longitud(counts)) {
        var count = counts[j]
        var bar_h = aEntero((count * (bottom - top)) / max_count)
        var x0 = left + (j * bin_w)
        var y0 = bottom - bar_h
        __grafico_rectangulo(x0, y0, bin_w - 1, bar_h, _bar_r, _bar_g, _bar_b, verdadero)
        j = j + 1
    }

    regresa counts
}

funcion _termina_en(texto, sufijo) {
    var t = aTexto(texto)
    var s = aTexto(sufijo)
    var lt = longitud(t)
    var ls = longitud(s)
    si (ls > lt) { regresa falso }
    var i = 0
    mientras (i < ls) {
        si (t[lt - ls + i] != s[i]) { regresa falso }
        i = i + 1
    }
    regresa verdadero
}

funcion guardar(path) {
    var p = aTexto(path)
    si (no (_termina_en(p, ".png") o _termina_en(p, ".ppm"))) {
        p = p + ".png"
    }
    regresa __grafico_guardar(p, _titulo, _xlabel, _ylabel)
}

funcion mostrar() {
    var p = __grafico_guardar("grafico.png", _titulo, _xlabel, _ylabel)
    regresa __grafico_mostrar(p, _titulo, _xlabel, _ylabel)
}

funcion texto(x, y0, texto_str, r, g, b) {
    __grafico_texto(aEntero(x), aEntero(y0), aTexto(texto_str), aEntero(r), aEntero(g), aEntero(b), 12)
    regresa nulo
}

# ------------------------------------------------------------------
# Funciones de layout y dibujo de grafos
# ------------------------------------------------------------------

funcion _layout_circular(n) {
    var coords = []
    var i = 0
    mientras (i < n) {
        var ang = (i * 2 * 3.14159265) / n
        var x = 0.5 + 0.4 * math.coseno(ang)
        var yy = 0.5 + 0.4 * math.seno(ang)
        coords.agregar([x, yy])
        i = i + 1
    }
    regresa coords
}

funcion dibujar_grafo(nodos, aristas, ancho, alto) {
    si (ancho == nulo) { ancho = 1 }
    si (alto == nulo) { alto = 1 }

    var n = longitud(nodos)
    var coords = []
    var i = 0
    var has_coords = verdadero
    mientras (i < n) {
        var nd = nodos[i]
        si (tipo(nd) == "dict") {
            si (nd["x"] == nulo o nd["y"] == nulo) { has_coords = falso }
        } sino { has_coords = falso }
        i = i + 1
    }

    si (has_coords == falso) {
        var circ = _layout_circular(n)
        i = 0
        mientras (i < n) {
            coords.agregar([circ[i][0] * ancho, circ[i][1] * alto])
            i = i + 1
        }
    } sino {
        i = 0
        mientras (i < n) {
            var nd = nodos[i]
            coords.agregar([nd["x"] * ancho, nd["y"] * alto])
            i = i + 1
        }
    }

    iniciar_grafico(0, ancho, 0, alto)

    i = 0
    mientras (i < longitud(aristas)) {
        var e = aristas[i]
        var a = e[0]; var b = e[1]
        lineas([coords[a][0], coords[b][0]], [coords[a][1], coords[b][1]])
        i = i + 1
    }

    var xs = []; var ys = []
    i = 0
    mientras (i < n) {
        xs.agregar(coords[i][0]); ys.agregar(coords[i][1])
        i = i + 1
    }
    pintar_puntos(xs, ys, 0, 100, 200, 3)

    i = 0
    mientras (i < n) {
        var label = nodos[i]
        si (tipo(label) == "dict") { label = label["label"] }
        texto(aEntero(coords[i][0]) + 6, aEntero(coords[i][1]) - 6, aTexto(label), 50, 50, 50)
        i = i + 1
    }

    regresa n
}

funcion linea_sobre_grafico(xs, ys) {
    si (longitud(xs) != longitud(ys)) {
        imp "Error: linea_sobre_grafico requiere listas x e y del mismo tamano"
        regresa nulo
    }
    si (longitud(xs) == 0) {
        imp "Error: linea_sobre_grafico requiere al menos un punto"
        regresa nulo
    }

    var left = _MARGEN
    var right = _ANCHO - _MARGEN
    var top = _MARGEN
    var bottom = _ALTO - _MARGEN
    var spanx = _last_xmax - _last_xmin
    var spany = _last_ymax - _last_ymin
    si (spanx == 0) { spanx = 1 }
    si (spany == 0) { spany = 1 }

    var puntos = []
    var i = 0
    mientras (i < longitud(xs)) {
        var px = left + aEntero(((xs[i] - _last_xmin) * (right - left)) / spanx)
        var py = bottom - aEntero(((ys[i] - _last_ymin) * (bottom - top)) / spany)
        puntos.agregar([px, py])
        i = i + 1
    }

    i = 0
    mientras ((i + 1) < longitud(puntos)) {
        var p0 = puntos[i]
        var p1 = puntos[i + 1]
        __grafico_linea(aEntero(p0[0]), aEntero(p0[1]), aEntero(p1[0]), aEntero(p1[1]), _line_r, _line_g, _line_b, 2)
        i = i + 1
    }

    si (_usar_marcadores) {
        i = 0
        mientras (i < longitud(puntos)) {
            var p = puntos[i]
            __grafico_circulo(aEntero(p[0]), aEntero(p[1]), _tam_marcador, _point_r, _point_g, _point_b, verdadero)
            i = i + 1
        }
    }

    regresa longitud(puntos)
}
