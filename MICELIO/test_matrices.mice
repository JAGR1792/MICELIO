# Prueba de las nuevas funciones de matrices
importar "modulos_std/matriz.mice" como mat
importar "modulos_std/math.mice" como math

# Probar determinante 1x1
var m1 = [[5]]
imprimir "Determinante 1x1:"
imprimir mat.determinante(m1)

# Probar determinante 2x2
var m2 = [[1, 2], [3, 4]]
imprimir "Determinante 2x2:"
imprimir mat.determinante(m2)

# Probar determinante 3x3
var m3 = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
imprimir "Determinante 3x3:"
imprimir mat.determinante(m3)

# Probar inversa 2x2
imprimir "Inversa 2x2:"
var inv2 = mat.inversa(m2)
imprimir inv2

# Multiplicar A * A^-1, debe dar aproximadamente I
imprimir "A * A^-1 (debe ser aproximadamente identidad):"
var producto = mat.multiplicar(m2, inv2)
imprimir producto
