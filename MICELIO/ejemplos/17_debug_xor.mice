# Benchmark XOR optimizado (sin visualización)
importar "../stdlib/dl.mice" como dl
var X = [[0,0], [0,1], [1,0], [1,1]]
var Y = [[1,0], [0,1], [0,1], [1,0]]
var arq = [{"in":2, "out":8, "act":"relu"}, {"in":8, "out":2, "act":"softmax"}]
var modelo = dl.perceptron_multicapa(arq)
dl.entrenar_red(modelo, X, Y, 500, 0.3)
var res = dl.forward(modelo, X)
imp "Salida final: " + aTexto(res["salida"])
imp "Esperado: [[1,0],[0,1],[0,1],[1,0]]"
