# Ejemplo 06: El Problema de Caperucita Roja (Multi-etiqueta)
# Replicación del ejemplo del profesor usando Micelio DL
importar "../modulos_std/dl.mice" como dl

imp "--- Entrenamiento de Caperucita Roja ---"

# Entradas (Big Ears, Big Teeth, Handsome, Wrinkled)
var X = [
    [1, 1, 0, 0], # Lobo
    [0, 1, 1, 0], # Abuelita
    [0, 0, 0, 1]  # Cazador
]

# Salidas (Scream, Hug, Food, Kiss)
var Y = [
    [1, 0, 0, 0], # Gritar ante el lobo
    [0, 0, 1, 1], # Comida y Beso para abuelita
    [0, 1, 1, 0]  # Abrazo y Comida para cazador
]

# Definimos una arquitectura MLP:
# Entrada (4) -> Oculta (3) -> Salida (4)
var arq = [
    {"in": 4, "out": 3, "act": "relu"},
    {"in": 3, "out": 4, "act": "sigmoid"}
]

var modelo = dl.perceptron_multicapa(arq)

# Entrenamos la red
imp "Iniciando entrenamiento..."
dl.entrenar_red(modelo, X, Y, 5000, 0.2)

# Prueba con un caso nuevo (Lobo disfrazado)
imp "Predicción para caso [1, 1, 0, 0] (Lobo):"
var res = dl.forward(modelo, [[1, 1, 0, 0]])
imp "Probabilidades (Scream, Hug, Food, Kiss):"
imp res["salida"]

# Prueba con la Abuelita
imp "Predicción para caso [0, 1, 1, 0] (Abuelita):"
var res2 = dl.forward(modelo, [[0, 1, 1, 0]])
imp res2["salida"]
