# ─── Ilustracion: XOR-2D — Datos de la Joya de la Corona ──────────
#   60 puntos en 4 clusters, 2 clases (patron XOR)
# ────────────────────────────────────────────────────────────────────
importar "../stdlib/grafico.mice" como g

# Generar mismos datos que 23_joya_clasificacion.mice
var X = []
var Y = []
var centros = [[-2, 2], [2, -2], [-2, -2], [2, 2]]
var labels = [[1, 0], [0, 1], [0, 1], [1, 0]]
var c = 0
mientras (c < 4) {
    var i = 0
    mientras (i < 15) {
        var xv = centros[c][0] + (aleatorio() * 2.5 - 1.25)
        var yv = centros[c][1] + (aleatorio() * 2.5 - 1.25)
        X.agregar([xv, yv])
        Y.agregar(labels[c])
        i = i + 1
    }
    c = c + 1
}

funcion argmax(fila) {
    var idx = 0
    var max_v = fila[0]
    var i = 1
    mientras (i < longitud(fila)) {
        si (fila[i] > max_v) { idx = i; max_v = fila[i] }
        i = i + 1
    }
    regresa idx
}

# Separar por clase
var c0x = []; var c0y = []
var c1x = []; var c1y = []
var i = 0
mientras (i < longitud(X)) {
    var cl = argmax(Y[i])
    si (cl == 0) { c0x.agregar(X[i][0]); c0y.agregar(X[i][1]) }
    sino { c1x.agregar(X[i][0]); c1y.agregar(X[i][1]) }
    i = i + 1
}

g.iniciar_grafico(-4.5, 4.5, -4.5, 4.5)
g.titulo("XOR-2D: 60 puntos, 4 clusters, 2 clases")
g.etiquetas("X", "Y")

# Clase 0 en azul
g.pintar_puntos(c0x, c0y, 60, 100, 200, 10)
g.texto(30, 35, "Clase 0 (xor=0)", 60, 100, 200)

# Clase 1 en rojo coral
g.pintar_puntos(c1x, c1y, 200, 60, 60, 10)
g.texto(30, 55, "Clase 1 (xor=1)", 200, 60, 60)

# Centroids como diamantes (marcados con cuadrados aprox)
var cx = [-2, 2, -2, 2]
var cy = [2, -2, -2, 2]
g.pintar_puntos([cx[0]], [cy[0]], 60, 100, 200, 16)
g.pintar_puntos([cx[1]], [cy[1]], 200, 60, 60, 16)
g.pintar_puntos([cx[2]], [cy[2]], 200, 60, 60, 16)
g.pintar_puntos([cx[3]], [cy[3]], 60, 100, 200, 16)

# Anotaciones de centro
g.texto(140, 100, "Centro (-2, 2)", 60, 100, 200)
g.texto(370, 340, "Centro (2, -2)", 200, 60, 60)
g.texto(95, 300, "Centro (-2, -2)", 200, 60, 60)
g.texto(480, 75, "Centro (2, 2)", 60, 100, 200)

g.guardar("ejemplos/graficos/ilustra_xor2d_clusters.png")
imp "Guardado: graficos/ilustra_xor2d_clusters.png"
g.mostrar()
