# Ejemplo 10: Autoencoder (Reduccion de Dimensionalidad)
importar "../stdlib/dl.mice" como dl

imp "--- Red Neuronal Autoencoder ---"

# Datos: Patrones de 4 bits
var X = [[1, 0, 0, 1], [0, 1, 1, 0], [1, 1, 1, 1], [0, 0, 0, 0]]

# Arquitectura: 4 (In) -> 2 (Latent) -> 4 (Out)
var arq = [{"in": 4, "out": 2, "act": "relu"}, {"in": 2, "out": 4, "act": "sigmoid"}]

var modelo = dl.perceptron_multicapa(arq)

imp "Entrenando Autoencoder para comprimir 4 bits en 2..."
dl.entrenar_red(modelo, X, X, 3000, 0.1)

imp "Reconstruccion de [1, 0, 0, 1]:"
var res = dl.forward(modelo, [[1, 0, 0, 1]])
imp res["salida"]
