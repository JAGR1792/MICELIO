importar "../stdlib/lista.mice" como lst

imp "-- Ejemplo 23: Lista didactica --"

var datos = [3, 1, 3, 2, 5, 2, 8, 5]
imp "original = " + aTexto(datos)
imp "contiene 5? " + aTexto(lst.contiene(datos, 5))
imp "sin duplicados = " + aTexto(lst.sin_duplicados(datos))
imp "porcion(2, 6) = " + aTexto(lst.porcion(datos, 2, 6))
imp "agrupar en 3 = " + aTexto(lst.agrupar(datos, 3))
imp "pares = " + aTexto(lst.pares(datos))
imp "impares = " + aTexto(lst.impares(datos))
