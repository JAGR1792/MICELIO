# ===================================================================
# archivo.mice – Módulo de entrada/salida de archivos
# Lectura y escritura de archivos, carga de datos para ML/DL
# ===================================================================

# Lee contenido completo de un archivo
funcion leer_archivo(ruta) {
    regresa __archivo_leer(ruta)
}

# Escribe contenido a un archivo
funcion escribir(ruta, contenido) {
    __archivo_escribir(ruta, contenido)
}

# Lee líneas de un archivo
funcion leer_lineas(ruta) {
    var contenido = leer_archivo(ruta)
    var lineas = []
    var linea_actual = ""
    var i = 0
    mientras (i < contenido.longitud()) {
        var car = contenido[i]
        si (car == "\n") {
            lineas.agregar(linea_actual)
            linea_actual = ""
        } sino {
            linea_actual = linea_actual + car
        }
        i = i + 1
    }
    si (linea_actual.longitud() > 0) {
        lineas.agregar(linea_actual)
    }
    regresa lineas
}

# Escribe líneas a un archivo
funcion escribir_lineas(ruta, lineas) {
    var contenido = ""
    var primera = verdadero
    para linea en lineas {
        si (no primera) {
            contenido = contenido + "\n"
        }
        contenido = contenido + linea
        primera = falso
    }
    escribir(ruta, contenido)
}

# Añade contenido a un archivo
funcion anexar(ruta, contenido) {
    var contenido_actual = leer_archivo(ruta)
    escribir(ruta, contenido_actual + contenido)
}

# Verifica si un archivo existe
funcion existe(ruta) {
    regresa __archivo_existe(ruta)
}

# Elimina un archivo
funcion eliminar(ruta) {
    __archivo_eliminar(ruta)
}

# Obtiene tamaño de archivo en bytes
funcion tamano(ruta) {
    regresa __archivo_tamano(ruta)
}

# Lee un archivo CSV como texto (devuelve lista de filas, cada fila es lista de strings)
funcion leer_csv(ruta, delimitador) {
    var lineas = leer_lineas(ruta)
    var resultado = []
    para linea en lineas {
        var partes = dividir_por(linea, delimitador)
        resultado.agregar(partes)
    }
    regresa resultado
}

# Divide cadena por delimitador
funcion dividir_por(cadena, delim) {
    var partes = []
    var parte = ""
    var i = 0
    mientras (i < cadena.longitud()) {
        si (cadena[i] == delim) {
            partes.agregar(parte)
            parte = ""
        } sino {
            parte = parte + cadena[i]
        }
        i = i + 1
    }
    partes.agregar(parte)
    regresa partes
}

# Escribe datos CSV
funcion escribir_csv(ruta, datos, delimitador) {
    var lineas = []
    para fila en datos {
        var linea = ""
        var primera = verdadero
        para valor en fila {
            si (no primera) {
                linea = linea + delimitador
            }
            linea = linea + aTexto(valor)
            primera = falso
        }
        lineas.agregar(linea)
    }
    escribir_lineas(ruta, lineas)
}

# ===================================================================
# Funciones de carga de datos para ML/DL
# ===================================================================

# Convierte una fila de strings a numeros
funcion _fila_a_numeros(fila) {
    var nums = []
    para valor en fila {
        nums.agregar(aNumero(valor))
    }
    regresa nums
}

# Carga CSV numerico: lee un archivo CSV y convierte todas las celdas a numeros
# Parametros:
#   ruta       - ruta del archivo
#   delimitador - caracter separador (por defecto ",")
#   saltar_cabecera - verdadero/falso (por defecto falso)
# Devuelve: lista de filas, cada fila es una lista de numeros
funcion cargar_numeros(ruta, delimitador, saltar_cabecera) {
    var filas_texto = leer_csv(ruta, delimitador)
    var numeros = []
    var inicio = 0
    si (saltar_cabecera) { inicio = 1 }
    var i = inicio
    mientras (i < filas_texto.longitud()) {
        numeros.agregar(_fila_a_numeros(filas_texto[i]))
        i = i + 1
    }
    regresa numeros
}

# Carga dataset para ML: separa features (X) y target (Y)
# Parametros:
#   ruta       - ruta del archivo
#   col_target - indice de la columna objetivo (0-based)
#   delimitador - caracter separador (por defecto ",")
#   saltar_cabecera - verdadero/falso (por defecto verdadero)
# Devuelve: {"X": [...], "Y": [...]}
funcion cargar_dataset(ruta, col_target, delimitador, saltar_cabecera) {
    var filas = cargar_numeros(ruta, delimitador, saltar_cabecera)
    var X = []
    var Y = []
    para fila en filas {
        var features = []
        var i = 0
        mientras (i < fila.longitud()) {
            si (i == col_target) {
                Y.agregar(fila[i])
            } sino {
                features.agregar(fila[i])
            }
            i = i + 1
        }
        X.agregar(features)
    }
    regresa {"X": X, "Y": Y}
}

# Carga matriz numerica (para DL): igual que cargar_numeros pero como alias semantico
# Devuelve: lista de filas (matriz), cada fila es una lista de numeros
funcion cargar_matriz(ruta, delimitador, saltar_cabecera) {
    regresa cargar_numeros(ruta, delimitador, saltar_cabecera)
}

# Guarda datos numericos como CSV (util para exportar resultados de ML)
# Parametros:
#   ruta       - ruta del archivo
#   datos      - lista de filas (cada fila es lista de numeros)
#   cabecera   - lista de nombres de columna (opcional, nulo para omitir)
#   delimitador - caracter separador (por defecto ",")
funcion guardar_datos(ruta, datos, cabecera, delimitador) {
    var filas_texto = []
    si (cabecera != nulo) {
        filas_texto.agregar(cabecera)
    }
    para fila en datos {
        var fila_str = []
        para valor en fila {
            fila_str.agregar(aTexto(valor))
        }
        filas_texto.agregar(fila_str)
    }
    escribir_csv(ruta, filas_texto, delimitador)
}

