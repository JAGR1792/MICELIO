importar "archivo.mice" como archivo
importar "math.mice" como math
importar "grafico.mice" como g

var xs = []
var senos = []

var i = 0
mientras (i < 100){
    var x = (i / 100.0) * 2 * math.PI
    xs.agregar(x)
    senos.agregar(math.seno(x))
    i = i + 1
}

datos = []

i = 0
mientras (i<xs.longitud()){

    datos.agregar([xs[i], senos[i]])
    i = i + 1
}
