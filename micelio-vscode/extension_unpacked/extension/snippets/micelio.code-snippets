{
  "Importar modulo": {
    "prefix": "import",
    "body": [
      "importar \"${1:math}.mice\" como ${2:math}"
    ],
    "description": "Inserta una declaracion de importacion con alias"
  },
  "Funcion": {
    "prefix": "fun",
    "body": [
      "funcion ${1:nombre}(${2:parametros}) {",
      "  ${3:cuerpo}",
      "}"
    ],
    "description": "Define una funcion"
  },
  "Si condicional": {
    "prefix": "si",
    "body": [
      "si (${1:condicion}) {",
      "  ${2:cuerpo}",
      "}"
    ],
    "description": "Bloque condicional if"
  },
  "Si sino condicional": {
    "prefix": "sino",
    "body": [
      "si (${1:condicion}) {",
      "  ${2:cuerpo}",
      "} sino {",
      "  ${3:alternativa}",
      "}"
    ],
    "description": "Bloque condicional if/else"
  },
  "Para cada": {
    "prefix": "para",
    "body": [
      "para ${1:elemento} en ${2:lista} {",
      "  ${3:cuerpo}",
      "}"
    ],
    "description": "Iteracion sobre una lista"
  },
  "Mientras": {
    "prefix": "mientras",
    "body": [
      "mientras (${1:condicion}) {",
      "  ${2:cuerpo}",
      "}"
    ],
    "description": "Bucle condicional while"
  },
  "Var declaracion": {
    "prefix": "var",
    "body": [
      "var ${1:nombre} = ${2:valor}"
    ],
    "description": "Declara una variable mutable"
  },
  "Const declaracion": {
    "prefix": "const",
    "body": [
      "const ${1:nombre} = ${2:valor}"
    ],
    "description": "Declara una constante"
  },
  "Regresa": {
    "prefix": "regresa",
    "body": [
      "regresa ${1:valor}"
    ],
    "description": "Retorna un valor de una funcion"
  },
  "Matriz 2D": {
    "prefix": "matriz",
    "body": [
      "[",
      "  [${1:0}, ${2:0}],",
      "  [${3:0}, ${4:0}]",
      "]"
    ],
    "description": "Literal de matriz bidimensional"
  },
  "Diccionario": {
    "prefix": "dict",
    "body": [
      "dict(",
      "  \"${1:clave}\", ${2:valor},",
      "  \"${3:clave}\", ${4:valor}",
      ")"
    ],
    "description": "Crea un diccionario con pares clave/valor"
  },
  "Set": {
    "prefix": "set",
    "body": [
      "set(${1:elementos})"
    ],
    "description": "Crea un conjunto"
  },
  "Pipe: composicion basica": {
    "prefix": "pipe",
    "body": [
      "${1:datos}",
      "  |> ${2:map}(funcion (${3:x}) { ${4:x} })"
    ],
    "description": "Inserta una composicion base con operador |>"
  },
  "Pipe: map": {
    "prefix": "pipe_map",
    "body": [
      "|> map(funcion (${1:x}) { ${2:x} })"
    ],
    "description": "Inserta un tramo map para una tuberia |>"
  },
  "Pipe: filter": {
    "prefix": "pipe_filter",
    "body": [
      "|> filter(funcion (${1:x}) { ${2:x > 0} })"
    ],
    "description": "Inserta un tramo filter para una tuberia |>"
  },
  "Pipe: reduce": {
    "prefix": "pipe_reduce",
    "body": [
      "|> reduce(funcion (${1:acc}, ${2:x}) { ${3:acc + x} }, ${4:0})"
    ],
    "description": "Inserta un tramo reduce para una tuberia |>"
  },
  "Pipe: ordenar": {
    "prefix": "pipe_ordenar",
    "body": [
      "|> ordenar()"
    ],
    "description": "Inserta un tramo ordenar para una tuberia |>"
  },
  "Pipe: cadena completa": {
    "prefix": "pipe_chain",
    "body": [
      "${1:datos}",
      "  |> map(funcion (${2:x}) { ${3:x} })",
      "  |> filter(funcion (${2:x}) { ${4:verdadero} })",
      "  |> ordenar()",
      "  |> reduce(funcion (${5:acc}, ${2:x}) { ${6:acc + x} }, ${7:0})"
    ],
    "description": "Inserta plantilla map/filter/ordenar/reduce con |>"
  },
  "Red neuronal: capa": {
    "prefix": "capa",
    "body": [
      "var ${1:capa} = ${2:crear_capa}.fc(${3:entradas}, ${4:salidas})"
    ],
    "description": "Crea una capa fully-connected para red neuronal"
  },
  "Red neuronal: entrenar": {
    "prefix": "entrenar",
    "body": [
      "para ${1:epoca} en rango(${2:500}) {",
      "  var ${3:pred} = ${4:red}.forward(${5:entrada})",
      "  var ${6:error} = ${4:red}.backward(${5:entrada}, ${7:objetivo})",
      "  si (${1:epoca} % 100 == 0) {",
      "    imp(\"Epoca \" + ${1:epoca} + \" - Error: \" + ${6:error})",
      "  }",
      "}"
    ],
    "description": "Bucle de entrenamiento para red neuronal"
  },
  "Grafico: inicializar": {
    "prefix": "grafico",
    "body": [
      "__grafico_reset(${1:800}, ${2:600})",
      "__grafico_draw_axes(${1:800}, ${2:600}, ${3:10})",
      "__grafico_set_pixel(${4:x}, ${5:y}, ${6:255}, ${7:0}, ${8:0})",
      "__grafico_guardar(\"${9:salida}.png\")"
    ],
    "description": "Inicializa un grafico y dibuja un pixel"
  },
  "Leer archivo": {
    "prefix": "leer",
    "body": [
      "var ${1:contenido} = leer(\"${2:archivo.txt}\")"
    ],
    "description": "Lee el contenido de un archivo"
  },
  "Prueba unitaria": {
    "prefix": "test",
    "body": [
      "# Test: ${1:descripcion}",
      "si (${2:expresion} == ${3:esperado}) {",
      "  imp(\"OK: ${1}\")",
      "} sino {",
      "  imp(\"FALLO: ${1} - se obtuvo \" + aTexto(${2:expresion}))",
      "}"
    ],
    "description": "Estructura basica para prueba unitaria"
  }
}
