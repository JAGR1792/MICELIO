# Regresion lineal: ingreso mensual vs edad (MICELIO)
# Usa los datos de ejemplos/data.csv (10280 filas)

importar "../stdlib/archivo.mice" como archivo
importar "../stdlib/ml.mice" como ml
importar "../stdlib/math.mice" como math
importar "../stdlib/grafico.mice" como g

imp "=== Regresion lineal: ingreso vs edad ==="

var filas = archivo.cargar_numeros_rapido("ejemplos/data.csv", ",", verdadero)
imp "Leidas " + aTexto(filas.longitud()) + " filas"

var edades = []
var ingresos = []

para fila en filas {
    var edad = aEntero(fila[1])
    var ingreso = aEntero(fila[3])
    si (edad != nulo y ingreso != nulo) {
        edades.agregar(edad)
        ingresos.agregar(ingreso)
    }
}

var n = edades.longitud()
imp "Muestras validas: " + aTexto(n)

var suma_edad = 0
para e en edades { suma_edad = suma_edad + e }
var prom_edad = suma_edad / n

var suma_ingreso = 0
para ing en ingresos { suma_ingreso = suma_ingreso + ing }
var prom_ingreso = suma_ingreso / n

imp ""
imp "=== Promedios ==="
imp "Edad promedio: " + aTexto(prom_edad) + " anios"
imp "Ingreso promedio: $" + aTexto(prom_ingreso)

# Modelo de regresion lineal
var modelo = ml.regresion_lineal(edades, ingresos)
var m = modelo["pendiente"]
var b = modelo["intercepcion"]
var predicciones = map(funcion(x) { ml.predecir_lineal(x, modelo) }, edades)
var r2 = ml.r_cuadrado(ingresos, predicciones)

imp ""
imp "=== Modelo: ingreso = m * edad + b ==="
imp "Pendiente (m): " + aTexto(m)
imp "Intercepto (b): " + aTexto(b)
imp "R^2: " + aTexto(r2)

# Predicciones
var pred_25 = m * 25 + b
var pred_30 = m * 30 + b
var pred_40 = m * 40 + b
var pred_50 = m * 50 + b
var pred_60 = m * 60 + b

imp ""
imp "=== Predicciones ==="
imp "  25 anios -> $" + aTexto(pred_25)
imp "  30 anios -> $" + aTexto(pred_30)
imp "  40 anios -> $" + aTexto(pred_40)
imp "  50 anios -> $" + aTexto(pred_50)
imp "  60 anios -> $" + aTexto(pred_60)

# Grafico
var edades_m = []
var ingresos_m = []
var i = 0
mientras (i < n) {
    si (i % 50 == 0) {
        edades_m.agregar(edades[i])
        ingresos_m.agregar(ingresos[i])
    }
    i = i + 1
}

g.estilo("claro")
g.iniciar_grafico(10, 100, 0, 65000)
g.titulo("Ingreso vs Edad (" + aTexto(n) + " personas)")
g.etiquetas("Edad (anios)", "Ingreso mensual ($)")
g.pintar_puntos(edades_m, ingresos_m, 60, 130, 200, 3)
g.color_linea(200, 60, 60)
var x_min = 10; var x_max = 100
g.linea_sobre_grafico([x_min, x_max], [m*x_min+b, m*x_max+b])
g.guardar("graficos/regresion_edad_ingreso.png")
imp ""
imp "Guardado: graficos/regresion_edad_ingreso.png"